# Copiar a terraform.tfvars (gitignored) y completar con valores reales.

docker_hub_user  = "tu-usuario-dockerhub"
docker_hub_token = "tu-dockerhub-access-token"

# App Registration de Entra ID que representa esta API — exclusivo ADMIN.
entra_tenant_id = "00000000-0000-0000-0000-000000000000"
entra_audience  = "00000000-0000-0000-0000-000000000000"

# App OAuth de Google Cloud, usada como Identity Provider federado en Cognito — exclusivo RESIDENTE.
cognito_google_client_id     = "tu-google-client-id"
cognito_google_client_secret = "tu-google-client-secret"

# Origins exactos de GitHub Pages, sin slash final (ej. https://tu-usuario.github.io/Cloud-Native).
frontend_admin_origin     = "https://tu-usuario.github.io/nombre-repo-admin"
frontend_residente_origin = "https://tu-usuario.github.io/nombre-repo-residente"

# ms-gastos-comunes (Java/Spring Boot) configuracion recomendada para Fargate:
service_env_vars = {
  "ms-gastos-comunes" = {
    MANAGEMENT_HEALTH_RABBIT_ENABLED = "false"
    CONVIVO_ENTRA_CLAIMMAP_ADMIN     = "administrador"
    SPRING_PROFILES_ACTIVE           = "aws"
    EUREKA_ENABLED                   = "false"
    # Relay SMTP Brevo (NotificacionGastosConsumer). Usuario y remitente no
    # son secretos -- la clave SMTP va aparte, en mail_password (abajo).
    # SPRING_MAIL_* pisa el host/puerto fijos (smtp.gmail.com) de application-aws.yml.
    SPRING_MAIL_HOST                 = "smtp-relay.brevo.com"
    SPRING_MAIL_PORT                 = "587"
    MAIL_USERNAME                    = "usuario-smtp-de-brevo"
    MAIL_FROM                        = "convivo.notificaciones.par@gmail.com"
  }
  # Mismo relay para ms-espacios-comunes (app/events/correo.py hace STARTTLS + login
  # si SMTP_USUARIO no esta vacio). La clave (SMTP_CLAVE) sale del mismo secret.
  "ms-espacios-comunes" = {
    SMTP_HOST    = "smtp-relay.brevo.com"
    SMTP_PORT    = "587"
    SMTP_USUARIO = "usuario-smtp-de-brevo"
    MAIL_FROM    = "convivo.notificaciones.par@gmail.com"
  }
}

# Clave SMTP generada en Brevo (SMTP & API > SMTP) -- no la contraseña de la
# cuenta de Brevo. Va a AWS Secrets Manager (secrets.tf), no al código.
mail_password = "tu-clave-smtp-de-brevo"

# Cantidad de tareas deseadas para microservicios de dominio (TD-06):
# 1 para demo en AWS Academy Learner Lab ($100 presupuesto de por vida), subir a >=2 para HA en producción.
domain_desired_count = 1


# Opcional: validar JWT contra un User Pool de Cognito de otra cuenta (el que usa el frontend desplegado).
# Vacio = pool de esta cuenta. Los IDs no son secretos.
# cognito_external_user_pool_id = "us-east-1_xxxxxxxxx"
# cognito_external_client_id    = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
